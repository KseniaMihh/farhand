node_modules/
.env
.idea/
*.iml
dist/

# Next's build output, local environment files, and the two files it writes
# by itself: next-env.d.ts, and an AGENTS.md block that `next dev` re-adds on
# every run (farhand-web). This project's instructions are written by the
# people working on it — CLAUDE.md at the root — so a generated one is treated
# as build output.
.next/
.env*.local
next-env.d.ts
farhand-web/AGENTS.md

# TypeScript's incremental build cache.
*.tsbuildinfo

# The landing page's photographs as they were downloaded: 6000x4000, four
# megabytes between them. What ships is the 1600px WebP beside each one
# (#168), and the originals stay out of history because git has no way to
# take a committed file back out of it. Keep them wherever you keep the
# design file; they are the source to re-export from, not a build input.
farhand-web/images/*.jpg
