# Copy this file to .env and it will work as-is for local development.
# These credentials match docker-compose.yml and exist only on your machine.
# Never reuse them for anything real.

# Required. Validated at startup in src/env.ts.
DATABASE_URL="postgresql://farhand:farhand@localhost:5432/farhand"

# Where the frontend is served from. CORS allows this origin and no other, and
# a write whose Origin is anything else is refused. The default suits a Vite
# dev server; in production it is the one domain the app is served from.
# APP_ORIGIN="http://localhost:5173"

# Where unexpected errors are reported. Left out here on purpose: with no DSN
# nothing is initialised and nothing leaves your machine, which is what you want
# while developing. Production sets it; nothing else should.
# SENTRY_DSN="https://…@….ingest.sentry.io/…"

# Optional - these are the defaults, shown here so you know they exist.
# NODE_ENV=development
# RATE_LIMIT_ENABLED=true
# CSRF_ENABLED=true
#   Writes must carry an Origin (or Referer) matching APP_ORIGIN. A browser
#   sends one; curl and Postman do not, so a hand-made POST is refused with 403
#   unless you add -H "Origin: http://localhost:5173". Set this to false for an
#   afternoon of poking at the API by hand, never anywhere real.
# PORT=3000
# LOG_LEVEL=info

# Where uploaded files are stored. These point at the `storage` service in
# docker-compose.yml (S3Proxy), so they work as they are. Leave all five out
# and the API still runs — everything except files (src/env.ts). Production
# points them at Backblaze B2 (docs/14-deployment.md).
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="farhand-dev"
STORAGE_ACCESS_KEY_ID="farhand-local"
STORAGE_SECRET_ACCESS_KEY="farhand-local-secret"

# How email is sent (#119, decision 0014). COMMENTED OUT ON PURPOSE: without
# them the API prints the verification token to your terminal, which is what
# you want locally — copy it from there and POST it to /auth/verify-email.
# Uncomment them only to try the real provider from your laptop, and never
# commit a key.
#
# MAIL_API_KEY and MAIL_FROM stand or fall together. MAIL_FROM has to be an
# address Brevo has verified; what recipients actually see is that address with
# its domain replaced by Brevo's, until Farhand has a domain of its own.
# MAIL_REPLY_TO is deliberately empty: a verification email does not need
# replies, and a personal address here would be shown to every stranger who
# registers.
# MAIL_API_KEY="xkeysib-…"
# MAIL_FROM="farhand.app@example.com"
# MAIL_FROM_NAME="Farhand"
# MAIL_REPLY_TO=""
