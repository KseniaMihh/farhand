# Environment for the automated test suite. Loaded by vitest.config.ts, which
# overrides whatever is in your shell so a stray DATABASE_URL cannot point the
# tests at development data.
#
# This file IS committed, unlike .env. It holds no secrets — the credentials are
# the throwaway ones from docker-compose.yml — and committing it means `npm test`
# works on a fresh clone and in CI with no extra step.

NODE_ENV=test

# A different DATABASE from development, on the same Postgres container.
# The suite TRUNCATEs every table in here before each test.
DATABASE_URL="postgresql://farhand:farhand@localhost:5432/farhand_test"

# Test output should be assertions, not request logs. Raise it to "debug" for
# an afternoon when a test fails in a way you cannot explain.
LOG_LEVEL=silent
