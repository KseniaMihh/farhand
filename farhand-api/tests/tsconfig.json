{
  // The root tsconfig.json describes the *build*: rootDir "src", output to
  // "dist". Tests are neither, so they get their own project here rather than
  // being bolted onto that one.
  //
  // It has to be named tsconfig.json and live in this directory: typescript-
  // eslint's projectService picks the nearest tsconfig.json to each file, the
  // way an editor does, so this is what makes type-aware linting work on tests.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // Tests import from ../src, which is outside the inherited rootDir.
    "rootDir": "..",
    // Nothing here is compiled; Vitest transforms it in memory.
    "noEmit": true
  },
  // Files under src are pulled in automatically as imported dependencies.
  "include": ["**/*.ts"]
}
