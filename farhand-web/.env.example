# Where the proxy in next.config.ts sends /api/... requests.
#
# Left unset, it is the deployed API — which is what you want for browsing,
# and READ-ONLY on purpose: a write from http://localhost:3100 arrives at
# production with that Origin, and the site-wide origin guard refuses it with
# 403 (#28). That refusal is correct, and production's APP_ORIGIN is not to be
# changed to work around it.
#
# Developing a screen that signs in or writes anything? Run the API locally
# (cd ../farhand-api && npm run dev) and point this at it:
#
#   FARHAND_API_URL=http://localhost:3000
#
# Copy this file to .env.local, which Next loads and git ignores.
FARHAND_API_URL=https://farhand-api.onrender.com
